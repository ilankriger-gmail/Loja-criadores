# ============================================
# Loja de Criadores — variáveis de ambiente
# ============================================
# Copie para .env.local e preencha. Passo a passo em docs/LOJA.md.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (projeto só da Loja: login dos criadores + tabelas loja_*) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Segredos ---
# Cifra os tokens do Mercado Pago e os links de acesso. Texto longo e aleatório; NUNCA troque depois
# de ter vendas. Ex.: openssl rand -base64 48
LOJA_ENCRYPTION_KEY=

# --- Mercado Pago (aplicação marketplace em Suas integrações) ---
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Assinatura secreta dos webhooks (Suas integrações → Webhooks → Pagamentos)
MERCADOPAGO_WEBHOOK_SECRET=
# Taxa da plataforma por venda, em %. Padrão 5.
LOJA_TAXA_PERCENT=5

# --- E-mail com o link de acesso (Resend) ---
# Sem estas duas o link não vai por e-mail (o resto funciona). O domínio do remetente precisa
# estar verificado no Resend. Ex.: LOJA_EMAIL_FROM=Loja de Criadores <acesso@seudominio.com.br>
RESEND_API_KEY=
LOJA_EMAIL_FROM=

# --- IA (Anthropic) ---
ANTHROPIC_API_KEY=
# Modelo da IA vendida (padrão claude-sonnet-5)
LOJA_AI_MODEL=

# --- Só no desenvolvimento local ---
# 1 abre /vender sem login. Não vale em produção.
LOJA_DEV_BYPASS=
# id de um usuário do Supabase para o modo sem login
LOJA_DEV_USER_ID=
